/**
 * Pushes a copy of a Salesforce file into SharePoint. The Salesforce file is left
 * untouched, so the record keeps its attachment and SharePoint gets a mirror.
 *
 * One file is processed per execution and the remainder is chained, which keeps a
 * single VersionData blob in heap at a time no matter how many files were uploaded
 * in one go.
 */
public class SharePointOutboundQueueable implements Queueable, Database.AllowsCallouts {

    public class SyncItem {
        public Id contentDocumentId;
        public Id linkedEntityId;
        public SyncItem(Id contentDocumentId, Id linkedEntityId) {
            this.contentDocumentId = contentDocumentId;
            this.linkedEntityId = linkedEntityId;
        }
    }

    private List<SyncItem> pending;

    public SharePointOutboundQueueable(List<SyncItem> pending) {
        this.pending = pending == null ? new List<SyncItem>() : pending;
    }

    public void execute(QueueableContext context) {
        if (pending.isEmpty()) {
            return;
        }
        SyncItem item = pending.remove(0);
        try {
            process(item);
        } catch (Exception e) {
            System.debug(LoggingLevel.ERROR, 'SharePoint outbound sync failed: ' + e.getMessage() + '\n' + e.getStackTraceString());
            recordStatus(item.contentDocumentId, null, 'Failed: ' + abbreviate(e.getMessage()));
        }

        // Chaining is not permitted inside a test context.
        if (!pending.isEmpty() && !Test.isRunningTest()) {
            System.enqueueJob(new SharePointOutboundQueueable(pending));
        }
    }

    private void process(SyncItem item) {
        List<ContentVersion> versions = [
            SELECT Id, Title, PathOnClient, FileExtension, ContentSize, VersionData,
                   SharePoint_Item_URL__c, CreatedBy.Email
            FROM ContentVersion
            WHERE ContentDocumentId = :item.contentDocumentId AND IsLatest = true
            LIMIT 1
        ];
        if (versions.isEmpty()) {
            return;
        }
        ContentVersion cv = versions[0];

        // Already mirrored, or came from SharePoint in the first place.
        if (String.isNotBlank(cv.SharePoint_Item_URL__c)) {
            return;
        }

        Long maxBytes = SharePointConfig.maxFileSizeBytes();
        if (cv.ContentSize != null && cv.ContentSize > maxBytes) {
            recordStatus(item.contentDocumentId, null,
                'Skipped: ' + cv.ContentSize + ' bytes exceeds the configured limit of ' + maxBytes + '.');
            return;
        }

        String folderPath = buildFolderPath(item.linkedEntityId);
        String fileName = buildFileName(cv);

        Map<String, Object> driveItem = SharePointService.uploadFile(folderPath, fileName, cv.VersionData);
        String webUrl = (String) driveItem.get('webUrl');
        String itemId = (String) driveItem.get('id');

        stampColumns(itemId, fileName, cv.CreatedBy == null ? null : cv.CreatedBy.Email);

        recordStatus(item.contentDocumentId, webUrl, 'Synced ' + Datetime.now().format());
    }

    /**
     * Writes the library's own columns so a SharePoint user can see which Salesforce
     * file this is and who uploaded it. Column names come from custom metadata, so a
     * client whose library uses different columns needs no code change.
     * A column failure must not undo a successful upload, so it is logged, not thrown.
     */
    private static void stampColumns(String itemId, String fileName, String uploaderEmail) {
        if (String.isBlank(itemId)) {
            return;
        }
        SharePoint_Setting__mdt cfg = SharePointConfig.get();
        Map<String, Object> fields = new Map<String, Object>();
        if (String.isNotBlank(cfg.Column_File_Name__c)) {
            fields.put(cfg.Column_File_Name__c.trim(), fileName);
        }
        if (String.isNotBlank(cfg.Column_Uploaded_By__c) && String.isNotBlank(uploaderEmail)) {
            fields.put(cfg.Column_Uploaded_By__c.trim(), uploaderEmail);
        }
        if (fields.isEmpty()) {
            return;
        }
        try {
            SharePointService.setListItemFields(itemId, fields);
        } catch (Exception e) {
            System.debug(LoggingLevel.ERROR, 'File uploaded but columns not set: ' + e.getMessage());
        }
    }

    /**
     * {RootFolder}/{Object label}/{Record name} - {Record Id}
     * The Id suffix keeps folders stable when a record is renamed.
     */
    @TestVisible
    public static String buildFolderPath(Id recordId) {
        Schema.DescribeSObjectResult describe = recordId.getSObjectType().getDescribe();
        String recordName = String.valueOf(recordId);

        if (describe.fields.getMap().containsKey('Name') && describe.isAccessible()) {
            String soql = 'SELECT Name FROM ' + describe.getName() + ' WHERE Id = :recordId LIMIT 1';
            List<SObject> records = Database.query(soql);
            if (!records.isEmpty() && records[0].get('Name') != null) {
                recordName = String.valueOf(records[0].get('Name'));
            }
        }

        String path = SharePointService.sanitize(describe.getLabelPlural()) + '/' +
                      SharePointService.sanitize(recordName) + ' - ' + recordId;

        String root = SharePointConfig.rootFolder();
        return String.isBlank(root) ? path : root + '/' + path;
    }

    @TestVisible
    private static String buildFileName(ContentVersion cv) {
        String name = String.isNotBlank(cv.PathOnClient) ? cv.PathOnClient : cv.Title;
        if (String.isNotBlank(cv.FileExtension) && !name.toLowerCase().endsWith('.' + cv.FileExtension.toLowerCase())) {
            name += '.' + cv.FileExtension;
        }
        return SharePointService.sanitize(name);
    }

    /**
     * Stamps the outcome onto the ContentVersion. The bypass flag stops this update
     * from re-entering the trigger.
     */
    private static void recordStatus(Id contentDocumentId, String webUrl, String status) {
        List<ContentVersion> versions = [
            SELECT Id FROM ContentVersion
            WHERE ContentDocumentId = :contentDocumentId AND IsLatest = true
            LIMIT 1
        ];
        if (versions.isEmpty()) {
            return;
        }
        ContentVersion update_ = new ContentVersion(Id = versions[0].Id, SharePoint_Sync_Status__c = status);
        if (String.isNotBlank(webUrl)) {
            update_.SharePoint_Item_URL__c = webUrl;
        }

        Boolean previous = SharePointSyncBypass.disabled;
        SharePointSyncBypass.disabled = true;
        try {
            update update_;
        } catch (DmlException e) {
            System.debug(LoggingLevel.ERROR, 'Could not stamp sync status: ' + e.getMessage());
        } finally {
            SharePointSyncBypass.disabled = previous;
        }
    }

    private static String abbreviate(String message) {
        if (String.isBlank(message)) {
            return 'Unknown error';
        }
        return message.length() > 200 ? message.substring(0, 200) : message;
    }
}
