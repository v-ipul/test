/**
 * Thin wrapper over the Microsoft Graph drive endpoints.
 * All callouts go through the named credential configured in SharePoint_Setting__mdt,
 * whose URL must be https://graph.microsoft.com/v1.0
 */
public with sharing class SharePointService {

    public class SharePointException extends Exception {}

    private static final Integer TIMEOUT_MS = 120000;

    @TestVisible
    private static String cachedDriveBase;

    /**
     * Base for the site itself, with no drive attached.
     */
    private static String siteBase() {
        SharePoint_Setting__mdt cfg = SharePointConfig.get();
        if (String.isBlank(cfg.Named_Credential__c) || String.isBlank(cfg.Site_Hostname__c) || String.isBlank(cfg.Site_Path__c)) {
            throw new SharePointException('SharePoint_Setting__mdt is missing Named Credential, Site Hostname or Site Path.');
        }
        return 'callout:' + cfg.Named_Credential__c +
               '/sites/' + cfg.Site_Hostname__c +
               ':/sites/' + cfg.Site_Path__c + ':';
    }

    /**
     * Leave Drive Name blank to use the site's default document library, which is
     * addressed by path and costs no extra callout. Set it to the display name of a
     * specific library (for example "WB Salesforce - POC") and the drive id is looked
     * up once per transaction and cached.
     */
    @TestVisible
    private static String driveBase() {
        if (cachedDriveBase != null) {
            return cachedDriveBase;
        }
        SharePoint_Setting__mdt cfg = SharePointConfig.get();
        String driveName = cfg.Drive_Name__c;

        if (String.isBlank(driveName)) {
            cachedDriveBase = siteBase() + '/drive';
        } else {
            cachedDriveBase = 'callout:' + cfg.Named_Credential__c + '/drives/' + resolveDriveId(driveName.trim());
        }
        return cachedDriveBase;
    }

    /**
     * Matches on the library's display name as shown in SharePoint.
     */
    private static String resolveDriveId(String driveName) {
        HttpResponse res = send('GET', siteBase() + '/drives', null, null, 'application/json');
        if (res.getStatusCode() != 200) {
            throw new SharePointException('Could not list document libraries (HTTP ' +
                res.getStatusCode() + '): ' + truncate(res.getBody()));
        }
        Map<String, Object> parsed = (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
        List<Object> drives = (List<Object>) parsed.get('value');

        List<String> available = new List<String>();
        if (drives != null) {
            for (Object entry : drives) {
                Map<String, Object> drive = (Map<String, Object>) entry;
                String name = (String) drive.get('name');
                available.add(name);
                if (name != null && name.equalsIgnoreCase(driveName)) {
                    return (String) drive.get('id');
                }
            }
        }
        throw new SharePointException('Document library "' + driveName +
            '" was not found on this site. Libraries available: ' + String.join(available, ', '));
    }

    /**
     * urlEncode turns spaces into '+', which is correct for query strings and wrong
     * for path segments. Graph path addressing needs %20.
     */
    public static String encodeSegment(String segment) {
        return EncodingUtil.urlEncode(segment, 'UTF-8').replace('+', '%20');
    }

    public static String encodePath(String path) {
        List<String> encoded = new List<String>();
        if (String.isNotBlank(path)) {
            for (String part : path.split('/')) {
                if (String.isNotBlank(part)) {
                    encoded.add(encodeSegment(part));
                }
            }
        }
        return String.join(encoded, '/');
    }

    private static HttpResponse send(String method, String url, Blob body, String contentType, String accept) {
        HttpRequest req = new HttpRequest();
        req.setEndpoint(url);
        req.setMethod(method);
        req.setTimeout(TIMEOUT_MS);
        if (String.isNotBlank(accept)) {
            req.setHeader('Accept', accept);
        }
        if (body != null) {
            req.setHeader('Content-Type', contentType);
            req.setBodyAsBlob(body);
        }
        return new Http().send(req);
    }

    /**
     * Simple upload of a NEW file. Salesforce never edits or replaces a document that
     * already exists in SharePoint: conflictBehavior=rename means a name clash creates
     * "quote 1.pdf" beside the original instead of overwriting it and pushing a new
     * version onto someone else's document.
     *
     * Switch CONFLICT_BEHAVIOUR to 'fail' if a clash should be rejected outright
     * rather than landing under a new name; the 409 is already handled below.
     *
     * Returns the created driveItem, whose 'name' is the name SharePoint actually
     * used, which differs from the requested one whenever a rename happened.
     *
     * If the destination folder does not exist yet Graph answers 404, so we create
     * the folder chain and retry once. That keeps the happy path to a single callout.
     */
    /**
     * Result of an upload: the file itself, plus the record folder when this upload
     * was the thing that created it. createdFolder is null when the folder already
     * existed, which is what lets the caller grant folder access exactly once.
     */
    public class UploadResult {
        public Map<String, Object> item;
        public Map<String, Object> createdFolder;
    }

    private static final String CONFLICT_BEHAVIOUR = 'rename';

    public static UploadResult uploadFile(String folderPath, String fileName, Blob content) {
        if (content == null) {
            throw new SharePointException('File body is empty.');
        }
        String url = driveBase() + '/root:/' + encodePath(folderPath) + '/' + encodeSegment(fileName) +
                     ':/content?@microsoft.graph.conflictBehavior=' + CONFLICT_BEHAVIOUR;

        UploadResult result = new UploadResult();

        HttpResponse res = send('PUT', url, content, 'application/octet-stream', 'application/json');
        if (res.getStatusCode() == 404) {
            result.createdFolder = ensureFolder(folderPath);
            res = send('PUT', url, content, 'application/octet-stream', 'application/json');
        }
        if (res.getStatusCode() == 409) {
            throw new SharePointException('A file named "' + fileName +
                '" already exists in SharePoint and was left untouched.');
        }
        if (res.getStatusCode() != 200 && res.getStatusCode() != 201) {
            throw new SharePointException('Upload failed (HTTP ' + res.getStatusCode() + '): ' + truncate(res.getBody()));
        }
        result.item = (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
        return result;
    }

    /**
     * Creates each missing segment of folderPath. conflictBehavior=fail means an
     * existing folder comes back as 409, which we treat as success rather than
     * overwriting anything already in the library.
     *
     * Returns the LAST segment's driveItem when that segment was newly created, or
     * null when it already existed.
     */
    public static Map<String, Object> ensureFolder(String folderPath) {
        List<String> segments = new List<String>();
        if (String.isNotBlank(folderPath)) {
            for (String part : folderPath.split('/')) {
                if (String.isNotBlank(part)) {
                    segments.add(part);
                }
            }
        }
        String parent = '';
        Map<String, Object> created = null;

        for (String segment : segments) {
            String url = driveBase() + '/root' +
                (String.isBlank(parent) ? '' : ':/' + encodePath(parent) + ':') + '/children';

            Map<String, Object> payload = new Map<String, Object>{
                'name' => segment,
                'folder' => new Map<String, Object>(),
                '@microsoft.graph.conflictBehavior' => 'fail'
            };
            HttpResponse res = send('POST', url, Blob.valueOf(JSON.serialize(payload)), 'application/json', 'application/json');
            Integer status = res.getStatusCode();

            if (status == 200 || status == 201) {
                created = (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
            } else if (status == 409) {
                created = null;
            } else {
                throw new SharePointException('Could not create folder "' + segment +
                    '" (HTTP ' + status + '): ' + truncate(res.getBody()));
            }
            parent = String.isBlank(parent) ? segment : parent + '/' + segment;
        }
        return created;
    }

    public static List<Object> listChildren(String folderPath) {
        String url = String.isBlank(folderPath)
            ? driveBase() + '/root/children'
            : driveBase() + '/root:/' + encodePath(folderPath) + ':/children';

        HttpResponse res = send('GET', url, null, null, 'application/json');
        if (res.getStatusCode() != 200) {
            throw new SharePointException('Could not list "' + folderPath +
                '" (HTTP ' + res.getStatusCode() + '): ' + truncate(res.getBody()));
        }
        Map<String, Object> parsed = (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
        List<Object> values = (List<Object>) parsed.get('value');
        return values == null ? new List<Object>() : values;
    }

    /**
     * Graph answers /content with a 302 to a pre-authenticated CDN URL. Apex follows
     * redirects on GET, but if the org blocks the hop we follow it explicitly, which
     * requires a Remote Site Setting for https://*.sharepoint.com
     */
    public static Blob download(String itemId) {
        return fetchBinary(driveBase() + '/items/' + encodeSegment(itemId) + '/content');
    }

    private static Blob fetchBinary(String url) {
        HttpResponse res = send('GET', url, null, null, null);

        Integer status = res.getStatusCode();
        if (status == 301 || status == 302 || status == 303 || status == 307) {
            String location = res.getHeader('Location');
            if (String.isBlank(location)) {
                throw new SharePointException('SharePoint returned a redirect with no Location header.');
            }
            res = send('GET', location, null, null, null);
            status = res.getStatusCode();
        }
        if (status != 200) {
            throw new SharePointException('Download failed (HTTP ' + status + '): ' + truncate(res.getBody()));
        }
        return res.getBodyAsBlob();
    }

    private static String truncate(String body) {
        if (String.isBlank(body)) {
            return '(empty response)';
        }
        return body.length() > 500 ? body.substring(0, 500) : body;
    }

    /**
     * SharePoint rejects " * : < > ? / \ | # % and leading or trailing spaces.
     */
    /**
     * Version history for a drive item, newest first as Graph returns it.
     */
    public static List<Object> listVersions(String itemId) {
        String url = driveBase() + '/items/' + encodeSegment(itemId) + '/versions';
        HttpResponse res = send('GET', url, null, null, 'application/json');
        if (res.getStatusCode() != 200) {
            throw new SharePointException('Could not read version history (HTTP ' +
                res.getStatusCode() + '): ' + truncate(res.getBody()));
        }
        Map<String, Object> parsed = (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
        List<Object> values = (List<Object>) parsed.get('value');
        return values == null ? new List<Object>() : values;
    }

    /**
     * Bytes of one historical version. Graph has no public download URL for a version,
     * so the content is pulled through Apex rather than handing the browser a link.
     */
    public static Blob downloadVersion(String itemId, String versionId) {
        String url = driveBase() + '/items/' + encodeSegment(itemId) +
                     '/versions/' + encodeSegment(versionId) + '/content';
        return fetchBinary(url);
    }

    public static Map<String, Object> getItem(String itemId) {
        String url = driveBase() + '/items/' + encodeSegment(itemId);
        HttpResponse res = send('GET', url, null, null, 'application/json');
        if (res.getStatusCode() != 200) {
            throw new SharePointException('Could not read item (HTTP ' +
                res.getStatusCode() + '): ' + truncate(res.getBody()));
        }
        return (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
    }

    /**
     * Writes the library's custom columns on an uploaded file. Keys must be the
     * column's internal name, not its display name.
     */
    public static void setListItemFields(String itemId, Map<String, Object> fields) {
        if (fields == null || fields.isEmpty()) {
            return;
        }
        String url = driveBase() + '/items/' + encodeSegment(itemId) + '/listItem/fields';
        HttpResponse res = send('PATCH', url, Blob.valueOf(JSON.serialize(fields)), 'application/json', 'application/json');
        if (res.getStatusCode() != 200) {
            throw new SharePointException('Could not set list item fields (HTTP ' +
                res.getStatusCode() + '): ' + truncate(res.getBody()));
        }
    }

    /**
     * Grants one person access to a single file.
     *
     * This is ADDITIVE. The file still inherits the library's permissions, so everyone
     * who could already see the library can still see it — this only adds the named
     * person on top. Making a file exclusive requires breaking role inheritance, which
     * Graph does not expose and which needs Full Control on the site.
     *
     * sendInvitation=false keeps SharePoint from emailing the person; requireSignIn
     * ties the grant to their identity rather than issuing an anonymous link.
     */
    public static void grantAccess(String itemId, String email, String role) {
        if (String.isBlank(itemId) || String.isBlank(email)) {
            return;
        }
        String cleanEmail = normaliseEmail(email);
        String effectiveRole = String.isBlank(role) ? 'read' : role.trim().toLowerCase();

        Map<String, Object> payload = new Map<String, Object>{
            'recipients' => new List<Object>{ new Map<String, Object>{ 'email' => cleanEmail } },
            'requireSignIn' => true,
            'sendInvitation' => false,
            'roles' => new List<String>{ effectiveRole }
        };

        String url = driveBase() + '/items/' + encodeSegment(itemId) + '/invite';
        HttpResponse res = send('POST', url, Blob.valueOf(JSON.serialize(payload)), 'application/json', 'application/json');

        if (res.getStatusCode() != 200 && res.getStatusCode() != 201) {
            throw new SharePointException('Could not grant access to ' + cleanEmail +
                ' (HTTP ' + res.getStatusCode() + '): ' + truncate(res.getBody()));
        }
    }

    /**
     * Sandbox refreshes append ".invalid" to every user email, which matches no Entra
     * account. Stripping it lets the same code be tested in a sandbox and run in
     * production unchanged; no real address ends in .invalid.
     */
    @TestVisible
    private static String normaliseEmail(String email) {
        String trimmed = email == null ? '' : email.trim();
        while (trimmed.toLowerCase().endsWith('.invalid')) {
            trimmed = trimmed.substring(0, trimmed.length() - 8);
        }
        return trimmed;
    }

    public static String sanitize(String raw) {
        if (String.isBlank(raw)) {
            return 'Untitled';
        }
        String cleaned = raw.replaceAll('[\\\\/:*?"<>|#%]', '-').trim();
        if (cleaned.length() > 100) {
            cleaned = cleaned.substring(0, 100).trim();
        }
        return String.isBlank(cleaned) ? 'Untitled' : cleaned;
    }
}
