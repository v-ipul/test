String NC   = 'callout:Sharepoint_Named_Credential';
String SITE = '/sites/bankunited.sharepoint.com:/sites/WB:';

// find the POC library
HttpRequest r1 = new HttpRequest();
r1.setEndpoint(NC + SITE + '/drives');
r1.setMethod('GET');
HttpResponse s1 = new Http().send(r1);

String driveId;
for (Object o : (List<Object>)((Map<String,Object>) JSON.deserializeUntyped(s1.getBody())).get('value')) {
    Map<String,Object> d = (Map<String,Object>) o;
    System.debug('LIBRARY: ' + d.get('name') + '  ->  ' + d.get('id'));
    if (((String) d.get('name')).containsIgnoreCase('POC')) {
        driveId = (String) d.get('id');
    }
}
System.debug('DRIVE ID: ' + driveId);

// write a test file to the library root
HttpRequest r2 = new HttpRequest();
r2.setEndpoint(NC + '/drives/' + driveId + '/root:/test-from-salesforce.txt:/content');
r2.setMethod('PUT');
r2.setHeader('Content-Type', 'text/plain');
r2.setBodyAsBlob(Blob.valueOf('Hello from Salesforce'));
HttpResponse s2 = new Http().send(r2);

System.debug('STATUS: ' + s2.getStatusCode());
System.debug('BODY: ' + s2.getBody());

