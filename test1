What you need, in order

First, the metadata — Apex won't save without it:

Custom metadata type SharePoint_Setting__mdt with 10 fields: Named_Credential__c, Site_Hostname__c, Site_Path__c, Drive_Name__c, Root_Folder__c, Column_File_Name__c, Column_Uploaded_By__c, Synced_Objects__c (all Text 255), Outbound_Sync_Enabled__c (Checkbox), Max_File_Size_Bytes__c (Number 12,0)
The Default record on that type, filled in with your values
Two ContentVersion fields: SharePoint_Item_URL__c (URL) and SharePoint_Sync_Status__c (Text 255)

--------------------------------------------


String driveId = 'PASTE_DRIVE_ID_HERE';
String NC = 'callout:Sharepoint_Named_Credential';

ContentVersion cv = [
    SELECT Title, PathOnClient, FileExtension, ContentSize, VersionData
    FROM ContentVersion
    WHERE IsLatest = true
    ORDER BY CreatedDate DESC
    LIMIT 1
];
System.debug('FILE: ' + cv.PathOnClient + ' (' + cv.ContentSize + ' bytes)');

String fileName = String.isNotBlank(cv.PathOnClient) ? cv.PathOnClient : cv.Title;
String encoded  = EncodingUtil.urlEncode(fileName, 'UTF-8').replace('+', '%20');

HttpRequest req = new HttpRequest();
req.setEndpoint(NC + '/drives/' + driveId + '/root:/' + encoded + ':/content');
req.setMethod('PUT');
req.setHeader('Content-Type', 'application/octet-stream');
req.setBodyAsBlob(cv.VersionData);
req.setTimeout(120000);


HttpResponse res = new Http().send(req);
System.debug('STATUS: ' + res.getStatusCode());

