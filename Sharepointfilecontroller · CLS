/**
 * Backs the sharepointFileViewer LWC.
 *
 * Reads the SharePoint folder belonging to the current record, returns version history
 * for a document in it, and copies a chosen version back into Salesforce.
 *
 * The three @AuraEnabled methods here are exactly what the component imports:
 * getRecordFiles, getFileVersions, restoreVersionToRecord.
 */
public with sharing class SharePointFileController {

    /**
     * Files in this record's own SharePoint folder. A folder that does not exist yet
     * returns an empty list rather than an error, because a record with no synced files
     * is an ordinary state. Genuine failures such as a 403 are surfaced.
     */
    @AuraEnabled
    public static List<FileMetadata> getRecordFiles(Id recordId) {
        if (recordId == null) {
            throw buildException('This component has to be placed on a record page.');
        }
        try {
            String folderPath = SharePointOutboundQueueable.buildFolderPath(recordId);
            List<FileMetadata> files = new List<FileMetadata>();

            for (Object entry : SharePointService.listChildren(folderPath)) {
                Map<String, Object> item = (Map<String, Object>) entry;
                if (item.containsKey('folder')) {
                    continue;
                }
                FileMetadata f = new FileMetadata();
                f.id = (String) item.get('id');
                f.name = (String) item.get('name');
                f.webUrl = (String) item.get('webUrl');
                f.size = toLong(item.get('size'));
                f.createdBy = displayName(item.get('createdBy'));
                f.lastModifiedBy = displayName(item.get('lastModifiedBy'));
                f.lastModifiedDateTime = (String) item.get('lastModifiedDateTime');
                files.add(f);
            }
            return files;

        } catch (SharePointService.SharePointException e) {
            if (e.getMessage().contains('404') || e.getMessage().containsIgnoreCase('itemNotFound')) {
                return new List<FileMetadata>();
            }
            throw buildException(e.getMessage());
        } catch (Exception e) {
            throw buildException(e.getMessage());
        }
    }

    @AuraEnabled
    public static List<VersionMetadata> getFileVersions(String itemId) {
        if (String.isBlank(itemId)) {
            throw buildException('No file was selected.');
        }
        try {
            List<VersionMetadata> versions = new List<VersionMetadata>();
            for (Object entry : SharePointService.listVersions(itemId)) {
                Map<String, Object> raw = (Map<String, Object>) entry;

                VersionMetadata v = new VersionMetadata();
                v.id = (String) raw.get('id');
                v.size = toLong(raw.get('size'));
                v.lastModifiedDateTime = (String) raw.get('lastModifiedDateTime');
                v.lastModifiedBy = displayName(raw.get('lastModifiedBy'));
                versions.add(v);
            }
            return collapseMetadataVersions(versions);
        } catch (Exception e) {
            throw buildException(e.getMessage());
        }
    }

    /**
     * Pulls one historical version out of SharePoint and files it against the record as
     * a new Salesforce file.
     *
     * Graph exposes no public download URL for a version, so the bytes come through Apex.
     * That means the 6 MB synchronous heap limit applies here, which is tighter than the
     * outbound sync: a large document may sync to SharePoint successfully and still be
     * too big to restore.
     */
    @AuraEnabled
    public static Id restoreVersionToRecord(String itemId, String versionId, String fileName, Id recordId) {
        if (String.isBlank(itemId) || String.isBlank(versionId)) {
            throw buildException('No version was selected.');
        }
        if (recordId == null) {
            throw buildException('This component has to be placed on a record page.');
        }
        if (!Schema.SObjectType.ContentVersion.isCreateable() || !Schema.SObjectType.ContentDocumentLink.isCreateable()) {
            throw buildException('You do not have permission to add files to this record.');
        }

        Boolean previousBypass = SharePointSyncBypass.disabled;
        try {
            Blob body = SharePointService.downloadVersion(itemId, versionId);
            String safeName = buildRestoredName(fileName, versionId);

            ContentVersion cv = new ContentVersion(
                Title = safeName,
                PathOnClient = safeName,
                VersionData = body,
                SharePoint_Sync_Status__c = 'Restored from SharePoint version ' + versionId
            );

            // The bytes already live in SharePoint, so the outbound trigger must not push
            // this copy straight back and create a duplicate.
            SharePointSyncBypass.disabled = true;
            insert cv;

            Id contentDocumentId = [
                SELECT ContentDocumentId FROM ContentVersion WHERE Id = :cv.Id LIMIT 1
            ].ContentDocumentId;

            insert new ContentDocumentLink(
                ContentDocumentId = contentDocumentId,
                LinkedEntityId = recordId,
                ShareType = 'V',
                Visibility = 'AllUsers'
            );
            return cv.Id;

        } catch (Exception e) {
            throw buildException(e.getMessage());
        } finally {
            SharePointSyncBypass.disabled = previousBypass;
        }
    }

    /**
     * Writing the SF Name and SF ID columns updates the document's list item, and
     * SharePoint records that as a new version even though the file content is unchanged.
     * A single upload therefore appears as 1.0 and 2.0, which is confusing for users.
     *
     * Consecutive versions of identical size are collapsed into one entry, keeping the
     * OLDEST of each run - that is the version the content was actually uploaded as. The
     * surviving entries are then labelled V1, V2 and so on from oldest to newest.
     *
     * This is a heuristic: a genuine re-upload of a file whose size has not changed by a
     * single byte would also be collapsed. For documents that are edited rather than
     * replaced wholesale, size always differs, so this holds in practice.
     *
     * Graph returns versions newest first, and that order is preserved on the way out.
     */
    @TestVisible
    private static List<VersionMetadata> collapseMetadataVersions(List<VersionMetadata> newestFirst) {
        if (newestFirst.size() < 2) {
            applyLabels(newestFirst);
            return newestFirst;
        }

        List<VersionMetadata> kept = new List<VersionMetadata>();
        for (Integer i = 0; i < newestFirst.size(); i++) {
            VersionMetadata current = newestFirst[i];
            Boolean olderTwinExists = (i + 1 < newestFirst.size())
                && newestFirst[i + 1].size == current.size;

            // Skip this one: an older version of the same size holds the same content.
            if (!olderTwinExists) {
                kept.add(current);
            }
        }
        applyLabels(kept);
        return kept;
    }

    /**
     * Numbers the surviving versions V1 upwards from the oldest, so the user sees a count
     * of real uploads rather than SharePoint's internal version numbers.
     */
    private static void applyLabels(List<VersionMetadata> newestFirst) {
        Integer number = newestFirst.size();
        for (VersionMetadata v : newestFirst) {
            v.label = 'V' + number;
            number--;
        }
    }

    /**
     * "quote.pdf" plus version 2.0 becomes "quote (v2.0).pdf" so the restored copy does
     * not collide with the current file in the Salesforce Files list.
     */
    @TestVisible
    private static String buildRestoredName(String fileName, String versionId) {
        String base = String.isBlank(fileName) ? 'SharePoint file' : fileName;
        Integer dot = base.lastIndexOf('.');
        if (dot > 0) {
            return base.substring(0, dot) + ' (v' + versionId + ')' + base.substring(dot);
        }
        return base + ' (v' + versionId + ')';
    }

    /**
     * Untyped JSON yields an Integer for small numbers and a Long or Decimal for large
     * ones, so a straight (Integer) cast throws on big files.
     */
    private static Long toLong(Object value) {
        if (value == null) {
            return 0;
        }
        return Long.valueOf(String.valueOf(value));
    }

    private static String displayName(Object identitySet) {
        if (identitySet == null) {
            return null;
        }
        Map<String, Object> user = (Map<String, Object>) ((Map<String, Object>) identitySet).get('user');
        return user == null ? null : (String) user.get('displayName');
    }

    /**
     * new AuraHandledException(msg) alone surfaces "Script-thrown exception" in the
     * browser. setMessage is what actually reaches error.body.message.
     */
    private static AuraHandledException buildException(String message) {
        AuraHandledException e = new AuraHandledException(message);
        e.setMessage(message);
        return e;
    }

    public class FileMetadata {
        @AuraEnabled public String id;
        @AuraEnabled public String name;
        @AuraEnabled public String webUrl;
        @AuraEnabled public Long size;
        @AuraEnabled public String createdBy;
        @AuraEnabled public String lastModifiedBy;
        @AuraEnabled public String lastModifiedDateTime;
    }

    public class VersionMetadata {
        @AuraEnabled public String id;
        @AuraEnabled public String label;
        @AuraEnabled public Long size;
        @AuraEnabled public String lastModifiedDateTime;
        @AuraEnabled public String lastModifiedBy;
    }
}
