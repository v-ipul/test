import { LightningElement, api } from 'lwc';
import { ShowToastEvent } from 'lightning/platformShowToastEvent';
import getRecordFiles from '@salesforce/apex/SharePointFileController.getRecordFiles';
import getUploadedFile from '@salesforce/apex/SharePointLargeFileController.getUploadedFile';
import startUpload from '@salesforce/apex/SharePointLargeFileController.startUpload';
import finishUpload from '@salesforce/apex/SharePointLargeFileController.finishUpload';
import getFileVersions from '@salesforce/apex/SharePointFileController.getFileVersions';

// Microsoft requires every chunk except the last to be a multiple of 320 KiB.
// 5 MB is 16 x 320 KiB.
const CHUNK_SIZE = 5 * 1024 * 1024;

export default class SharepointFileViewer extends LightningElement {
    @api recordId;

    isUploading = false;
    uploadProgress = 0;
    uploadFileName;

    files = [];
    isLoading = false;
    errorMessage;
    expandedId;
    versions = [];
    versionsLoading = false;

    connectedCallback() {
        this.loadFiles();
    }

    get hasFiles() {
        return this.files.length > 0;
    }

    get showEmptyState() {
        return !this.isLoading && !this.errorMessage && !this.hasFiles;
    }

    get decoratedFiles() {
        return this.files.map((file) => ({
            ...file,
            sizeLabel: this.formatSize(file.size),
            modifiedLabel: this.formatDate(file.lastModifiedDateTime),
            uploadedByLabel: file.uploadedByName || file.uploadedBy || 'Not recorded',
            isExpanded: file.id === this.expandedId,
            toggleLabel: file.id === this.expandedId ? 'Hide history' : 'Version history'
        }));
    }

    get decoratedVersions() {
        // Versions carry no uploader of their own. Every version of a file synced by this
        // integration was written by the same Salesforce user, so the file's recorded
        // uploader is shown against each row.
        const parent = this.files.find((f) => f.id === this.expandedId);
        const uploadedByLabel = parent
            ? parent.uploadedByName || parent.uploadedBy || 'Not recorded'
            : 'Not recorded';

        return this.versions.map((version) => ({
            ...version,
            uploadedByLabel,
            sizeLabel: this.formatSize(version.size),
            modifiedLabel: this.formatDate(version.lastModifiedDateTime)
        }));
    }

    get hasVersions() {
        return !this.versionsLoading && this.versions.length > 0;
    }

    async loadFiles() {
        this.isLoading = true;
        this.errorMessage = undefined;
        this.expandedId = undefined;
        this.versions = [];
        try {
            this.files = await getRecordFiles({ recordId: this.recordId });
        } catch (error) {
            this.files = [];
            this.errorMessage = this.reduceError(error);
        } finally {
            this.isLoading = false;
        }
    }

    handleRefresh() {
        this.loadFiles();
    }

    get acceptedFormats() {
        return [];
    }

    /**
     * The platform has already written the file into Salesforce Files and linked it to
     * the record. What happens next depends on size: a file the normal sync can carry is
     * left to it, and a larger one is pushed to SharePoint from the browser.
     */
    async handleSalesforceUploadFinished(event) {
        const uploaded = event.detail.files && event.detail.files[0];
        if (!uploaded) {
            return;
        }

        this.isUploading = true;
        this.uploadProgress = 0;
        this.errorMessage = undefined;

        try {
            const details = await getUploadedFile({ contentDocumentId: uploaded.documentId });
            this.uploadFileName = details.fileName;

            if (Number(details.size) <= Number(details.maxSyncSize)) {
                this.toast(
                    'Uploaded',
                    `${details.fileName} is in Salesforce and will sync to SharePoint shortly.`,
                    'success'
                );
                await this.loadFiles();
                return;
            }

            await this.pushToSharePoint(details);

        } catch (error) {
            this.errorMessage = this.reduceError(error);
            this.toast('SharePoint upload failed', this.errorMessage, 'error');
        } finally {
            this.isUploading = false;
            this.uploadProgress = 0;
            this.uploadFileName = undefined;
        }
    }

    /**
     * Reads the file back out of Salesforce and sends it to SharePoint in chunks. The
     * bytes travel browser to SharePoint directly, so no Apex heap limit applies.
     */
    async pushToSharePoint(details) {
        const download = await fetch(details.downloadUrl, { credentials: 'include' });
        if (!download.ok) {
            throw new Error(`Could not read the file back from Salesforce (HTTP ${download.status}).`);
        }
        const blob = await download.blob();

        const session = await startUpload({ recordId: this.recordId, fileName: details.fileName });
        const driveItem = await this.sendChunks(session.uploadUrl, blob);

        const problems = await finishUpload({
            recordId: this.recordId,
            itemId: driveItem.id,
            fileName: driveItem.name,
            webUrl: driveItem.webUrl,
            contentVersionId: details.contentVersionId
        });

        if (problems) {
            this.toast('Uploaded with warnings', `${driveItem.name} is in both systems, but ${problems}.`, 'warning');
        } else {
            this.toast('Uploaded', `${driveItem.name} is now in Salesforce and SharePoint.`, 'success');
        }
        await this.loadFiles();
    }

    async sendChunks(uploadUrl, file) {
        // 'file' is a Blob read back from Salesforce, sliced the same way a File is.
        let driveItem;

        for (let start = 0; start < file.size; start += CHUNK_SIZE) {
            const end = Math.min(start + CHUNK_SIZE, file.size);
            const chunk = file.slice(start, end);

            // No Authorization header: the upload URL is already pre-authenticated and
            // Microsoft rejects the request if one is attached.
            const response = await fetch(uploadUrl, {
                method: 'PUT',
                headers: {
                    'Content-Range': `bytes ${start}-${end - 1}/${file.size}`
                },
                body: chunk
            });

            if (response.status === 200 || response.status === 201) {
                driveItem = await response.json();
            } else if (response.status !== 202) {
                const detail = await response.text();
                throw new Error(`SharePoint rejected the upload (HTTP ${response.status}): ${detail}`);
            }

            this.uploadProgress = Math.round((end / file.size) * 100);
        }

        if (!driveItem || !driveItem.id) {
            throw new Error('The upload finished but SharePoint did not return a file.');
        }
        return driveItem;
    }

    async handleToggleVersions(event) {
        const fileId = event.currentTarget.dataset.id;

        if (this.expandedId === fileId) {
            this.expandedId = undefined;
            this.versions = [];
            return;
        }

        this.expandedId = fileId;
        this.versions = [];
        this.versionsLoading = true;
        this.errorMessage = undefined;
        try {
            this.versions = await getFileVersions({ itemId: fileId });
        } catch (error) {
            this.errorMessage = this.reduceError(error);
            this.toast('Could not load history', this.errorMessage, 'error');
            this.expandedId = undefined;
        } finally {
            this.versionsLoading = false;
        }
    }

    handleOpen(event) {
        const url = event.currentTarget.dataset.url;
        if (url) {
            window.open(url, '_blank', 'noopener');
        }
    }

    formatSize(bytes) {
        const size = Number(bytes);
        if (!size) {
            return '0 KB';
        }
        if (size < 1024) {
            return `${size} B`;
        }
        if (size < 1048576) {
            return `${(size / 1024).toFixed(1)} KB`;
        }
        return `${(size / 1048576).toFixed(1)} MB`;
    }

    formatDate(isoString) {
        if (!isoString) {
            return '';
        }
        const parsed = new Date(isoString);
        if (Number.isNaN(parsed.getTime())) {
            return '';
        }
        return parsed.toLocaleString(undefined, {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    reduceError(error) {
        if (Array.isArray(error?.body)) {
            return error.body.map((e) => e.message).join(', ');
        }
        return error?.body?.message || error?.message || 'Unexpected error. Check the browser console.';
    }

    toast(title, message, variant) {
        this.dispatchEvent(new ShowToastEvent({ title, message, variant }));
    }
}
