import { LightningElement, api } from 'lwc';
import { ShowToastEvent } from 'lightning/platformShowToastEvent';
import { RefreshEvent } from 'lightning/refresh';
import getRecordFiles from '@salesforce/apex/SharePointFileController.getRecordFiles';
import getFileVersions from '@salesforce/apex/SharePointFileController.getFileVersions';
import restoreVersionToRecord from '@salesforce/apex/SharePointFileController.restoreVersionToRecord';
import startUpload from '@salesforce/apex/SharePointLargeFileController.startUpload';
import finishUpload from '@salesforce/apex/SharePointLargeFileController.finishUpload';
import saveToSalesforce from '@salesforce/apex/SharePointLargeFileController.saveToSalesforce';

// Microsoft requires every chunk except the last to be a multiple of 320 KiB.
// 5 MB is 16 x 320 KiB.
const CHUNK_SIZE = 5 * 1024 * 1024;

// Above this, the file cannot be passed through an Apex request, so Salesforce receives
// a link record rather than the bytes. Base64 inflates a file by a third before it is
// sent, so this sits well below the Apex ceiling rather than at it.
const SALESFORCE_COPY_MAX = 3.5 * 1024 * 1024;

export default class SharepointFileViewer extends LightningElement {
    @api recordId;

    files = [];
    isLoading = false;
    errorMessage;

    expandedId;
    versions = [];
    versionsLoading = false;

    isUploading = false;
    uploadProgress = 0;
    uploadFileName;

    connectedCallback() {
        this.loadFiles();
    }

    get hasFiles() {
        return this.files.length > 0;
    }

    get showEmptyState() {
        return !this.isLoading && !this.isUploading && !this.errorMessage && !this.hasFiles;
    }

    get decoratedFiles() {
        return this.files.map((file) => ({
            ...file,
            sizeLabel: this.formatSize(file.size),
            modifiedLabel: this.formatDate(file.lastModifiedDateTime),
            isExpanded: file.id === this.expandedId,
            toggleLabel: file.id === this.expandedId ? 'Hide history' : 'Version history'
        }));
    }

    get decoratedVersions() {
        return this.versions.map((version) => ({
            ...version,
            sizeLabel: this.formatSize(version.size),
            modifiedLabel: this.formatDate(version.lastModifiedDateTime)
        }));
    }

    async loadFiles() {
        this.isLoading = true;
        this.errorMessage = undefined;
        this.expandedId = undefined;
        try {
            this.files = await getRecordFiles({ recordId: this.recordId });
        } catch (error) {
            this.files = [];
            this.errorMessage = this.reduceError(error);
        } finally {
            this.isLoading = false;
        }
    }

    handleRefresh() {
        this.loadFiles();
    }

    handleUploadClick() {
        this.template.querySelector('input[type="file"]').click();
    }

    /**
     * SharePoint first, then Salesforce. If SharePoint fails nothing is created in
     * Salesforce, so there is no orphan record to clean up, and the Salesforce link
     * record needs SharePoint's URL anyway.
     */
    async handleFileChosen(event) {
        const input = event.target;
        const file = input.files && input.files[0];
        if (!file) {
            return;
        }

        this.isUploading = true;
        this.uploadProgress = 0;
        this.uploadFileName = file.name;
        this.errorMessage = undefined;

        try {
            // 1. Ask SharePoint for a pre-authenticated upload address.
            const session = await startUpload({ recordId: this.recordId, fileName: file.name });

            // 2. Send the bytes straight from the browser. Apex never touches them, so
            //    the heap limit that caps the automatic sync does not apply.
            const driveItem = await this.sendChunks(session.uploadUrl, file);

            // 3. Library columns, owner access, and the folder link on the record.
            const problems = await finishUpload({
                recordId: this.recordId,
                itemId: driveItem.id,
                fileName: driveItem.name
            });

            // 4. The Salesforce copy: real bytes when small enough, otherwise a link.
            const smallEnough = file.size <= SALESFORCE_COPY_MAX;
            const saved = await saveToSalesforce({
                recordId: this.recordId,
                fileName: driveItem.name,
                base64Data: smallEnough ? await this.toBase64(file) : null,
                sharePointUrl: driveItem.webUrl
            });

            const where = saved.storedInSalesforce
                ? 'SharePoint and Salesforce'
                : 'SharePoint, with a link added to this record';

            // The columns, owner grant and folder link are secondary. The file is safely
            // uploaded by this point, so a problem with one of them is logged for support
            // rather than shown to the user.
            if (problems) {
                // eslint-disable-next-line no-console
                console.warn(`SharePoint follow-up steps incomplete: ${problems}`);
            }
            this.toast('Uploaded', `${driveItem.name} is in ${where}.`, 'success');

            await this.loadFiles();
            this.dispatchEvent(new RefreshEvent());

        } catch (error) {
            this.errorMessage = this.reduceError(error);
            this.toast('Upload failed', this.errorMessage, 'error');
        } finally {
            this.isUploading = false;
            this.uploadProgress = 0;
            this.uploadFileName = undefined;
            // Lets the same file be chosen again after a failure.
            input.value = null;
        }
    }

    async sendChunks(uploadUrl, file) {
        let driveItem;

        for (let start = 0; start < file.size; start += CHUNK_SIZE) {
            const end = Math.min(start + CHUNK_SIZE, file.size);
            const chunk = file.slice(start, end);

            // No Authorization header: the upload URL is already pre-authenticated and
            // Microsoft rejects the request if one is attached.
            const response = await fetch(uploadUrl, {
                method: 'PUT',
                headers: {
                    'Content-Range': `bytes ${start}-${end - 1}/${file.size}`
                },
                body: chunk
            });

            if (response.status === 200 || response.status === 201) {
                driveItem = await response.json();
            } else if (response.status !== 202) {
                const detail = await response.text();
                throw new Error(`SharePoint rejected the upload (HTTP ${response.status}): ${detail}`);
            }

            this.uploadProgress = Math.round((end / file.size) * 100);
        }

        if (!driveItem || !driveItem.id) {
            throw new Error('The upload finished but SharePoint did not return a file.');
        }
        return driveItem;
    }

    toBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            // readAsDataURL yields "data:<mime>;base64,<payload>" — Apex wants the payload.
            reader.onload = () => resolve(reader.result.split(',')[1]);
            reader.onerror = () => reject(new Error('The file could not be read for the Salesforce copy.'));
            reader.readAsDataURL(file);
        });
    }

    async handleToggleVersions(event) {
        const fileId = event.currentTarget.dataset.id;

        if (this.expandedId === fileId) {
            this.expandedId = undefined;
            this.versions = [];
            return;
        }

        this.expandedId = fileId;
        this.versions = [];
        this.versionsLoading = true;
        this.errorMessage = undefined;
        try {
            this.versions = await getFileVersions({ itemId: fileId });
        } catch (error) {
            this.errorMessage = this.reduceError(error);
            this.expandedId = undefined;
        } finally {
            this.versionsLoading = false;
        }
    }

    handleOpen(event) {
        const url = event.currentTarget.dataset.url;
        if (url) {
            window.open(url, '_blank', 'noopener');
        }
    }

    async handleRestore(event) {
        const versionId = event.currentTarget.dataset.version;
        const file = this.files.find((f) => f.id === this.expandedId);
        if (!file) {
            return;
        }

        this.versionsLoading = true;
        try {
            await restoreVersionToRecord({
                itemId: file.id,
                versionId,
                fileName: file.name,
                recordId: this.recordId
            });
            this.toast(
                'Version restored',
                `${file.name} version ${versionId} was added to this record as a Salesforce file.`,
                'success'
            );
            this.dispatchEvent(new RefreshEvent());
        } catch (error) {
            this.errorMessage = this.reduceError(error);
            this.toast('Restore failed', this.errorMessage, 'error');
        } finally {
            this.versionsLoading = false;
        }
    }

    formatSize(bytes) {
        const size = Number(bytes);
        if (!size) {
            return '0 KB';
        }
        if (size < 1024) {
            return `${size} B`;
        }
        if (size < 1048576) {
            return `${(size / 1024).toFixed(1)} KB`;
        }
        return `${(size / 1048576).toFixed(1)} MB`;
    }

    formatDate(isoString) {
        if (!isoString) {
            return '';
        }
        const parsed = new Date(isoString);
        return Number.isNaN(parsed.getTime()) ? '' : parsed.toLocaleString();
    }

    reduceError(error) {
        if (Array.isArray(error?.body)) {
            return error.body.map((e) => e.message).join(', ');
        }
        return error?.body?.message || error?.message || 'Unexpected error. Check the browser console.';
    }

    toast(title, message, variant) {
        this.dispatchEvent(new ShowToastEvent({ title, message, variant }));
    }
}
